highest_cloze_llms <- cloze_probs_llms %>%
group_by(InnerNumber, Item, Itemtype, participant) %>%
slice_max(cloze_probability, n = 1, with_ties = FALSE)
# import human cloze probs
cloze_probs_human <- read_excel("../human_data/Cloze_SpEng_n122_133cloze_prob.xlsx") %>%
#select(-1) %>%
mutate(participant = "human") %>%
rename(cloze_clean = cloze_clean_wtrans)
# choose the highest cloze probs for each item
highest_cloze_human <- cloze_probs_human %>%
group_by(InnerNumber, Item, Itemtype, participant) %>%
slice_max(cloze_probability, n = 1, with_ties = FALSE) %>%
select(InnerNumber, Item, Itemtype, n, total, cloze_clean, cloze_probability)
# merge llms and human
highest_cloze_human$inner_number <- as.numeric(highest_cloze_human$inner_number)
# merge llms and human
highest_cloze_human$InnerNumber <- as.numeric(highest_cloze_human$InnerNumber)
highest_cloze_llms$InnerNumber <- as.numeric(highest_cloze_llms$InnerNumber)
highest_cloze_all <- bind_rows(highest_cloze_human, highest_cloze_llms)
write_csv(highest_cloze_all, "highest_cloze_all.csv")
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(ggplot2)
library(lme4)
highest_cloze_all <- read_csv("/Users/zliu/Documents/C03_C11/SE/process_and_clean/highest_cloze_all.csv")
# plot
set.seed(123)  # reproducible jitter
ggplot(highest_cloze_all, aes(x = Itemtype, y = cloze_probability)) +
geom_violin(
aes(fill = Itemtype),
trim = FALSE,
alpha = 0.3
) +
geom_point(
aes(color = Itemtype),
position = position_jitter(width = 0.08),
size = 2.2,
alpha = 0.85
) +
stat_summary(
fun = mean,
geom = "point",
color = "red",
size = 4,
shape = 19
) +
stat_summary(
fun = mean,
geom = "crossbar",
width = 0.5,
fatten = 3,
color = "red"
) +
facet_wrap(~ participant) +          # seperate screen by participant
scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.2)) +
scale_fill_manual(values = c(
"English"    = "#3B6FB6",
"CodeSwitch" = "#D97A00"
)) +
scale_color_manual(values = c(
"English"    = "#3B6FB6",
"CodeSwitch" = "#D97A00"
)) +
labs(
title = "Highest cloze probability per item",
x     = "Language condition",
y     = "Max cloze Probability"
) +
theme_minimal(base_size = 16) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold")
)
