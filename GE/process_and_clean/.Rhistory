#| label: pattern-1
#| code-line-numbers: true
pattern <- r"--[(?xi)
\b         the / at          \s+
( (?:  [^\s/]+ / jj  [^\s]*  \s+ )*
(?:  [^\s/]+ / nn  [^\s]*  \s+ )*
[^\s/]+ / nn  [^\s]*
)                            \s+
of / in          \s+
the / at          \s+
( (?:  [^\s/]+ / jj  [^\s]*  \s+ )*
(?:  [^\s/]+ / nn  [^\s]*  \s+ )*
[^\s/]+ / nn  [^\s$]*
)                            \s
]--"
#| eval: false
#| label: template
cd <- brown_fnames |>
mclm::conc(pattern) |>  # whatever regex pattern we have defined
mutate(
gen_type = "of",                                     # or "s"
possessor_type = "common",                           # or "proper"
possessum = re_replace_first(match, pattern, "\\1"), # or "\\2" for s-genitive
possessor = re_replace_first(match, pattern, "\\2")  # or "\\1" for of-genitive
)
